{
  "name": "@littlearc/database",
  "version": "0.0.0",
  "private": true,
  "description": "LittleArc database adapters and migrations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./readiness": {
      "types": "./src/readiness.ts",
      "default": "./dist/readiness.js"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @littlearc/domain build && tsc --project tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "generate": "tsx src/migrations/write-generated.ts",
    "test": "vitest run src",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@littlearc/domain": "workspace:*",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.1"
  }
}
