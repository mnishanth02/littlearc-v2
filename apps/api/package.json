{
  "name": "@littlearc/api",
  "version": "0.0.0",
  "private": true,
  "description": "LittleArc Fastify API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "dev": "pnpm build --watch",
    "start": "node dist/index.js",
    "test": "pnpm --filter @littlearc/contracts build && pnpm --filter @littlearc/database build && pnpm --filter @littlearc/observability build && vitest run src",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@littlearc/auth": "workspace:*",
    "@littlearc/contracts": "workspace:*",
    "@littlearc/database": "workspace:*",
    "@littlearc/observability": "workspace:*",
    "fastify": "5.10.0"
  }
}
