# Safe local process configuration.
APP_ENV=local
FILE_VALIDATION_ENABLED=false
FILE_PREVIEWS_ENABLED=false
FILE_VALIDATION_STAGING_PROBE=false
FILE_VALIDATION_TMP_DIR=
FILE_VALIDATION_CONCURRENCY=1
FILE_VALIDATION_SANDBOX_EXECUTABLE=
QPDF_EXECUTABLE=/usr/bin/qpdf
CLAMD_HOST=
CLAMD_PORT=3310
CLAMD_SIGNATURE_MAX_AGE_HOURS=24
CLAMD_SIGNATURE_MIN_VERSION=
CLAMD_SIGNATURE_OBSERVED_AT=

# Secrets and sensitive provider configuration remain blank in repository files.
DATABASE_URL=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto
KEY_WRAPPING_SECRET_V1=
EMAIL_PROVIDER_API_KEY=
PUSH_PROVIDER_CREDENTIALS=
AI_PROVIDER_CREDENTIALS=
