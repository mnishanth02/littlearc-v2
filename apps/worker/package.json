{
  "name": "@littlearc/worker",
  "version": "0.0.0",
  "private": true,
  "description": "LittleArc background worker",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "dev": "pnpm build --watch",
    "start": "node dist/index.js",
    "test": "pnpm --filter @littlearc/database build && pnpm --filter @littlearc/observability build && vitest run src",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@littlearc/database": "workspace:*",
    "@littlearc/observability": "workspace:*",
    "pg-boss": "12.26.1"
  }
}
