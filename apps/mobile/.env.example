# Public values are embedded in the mobile client and must never contain secrets.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
# Build-time iOS signing profile. Registered remains the safe default.
LITTLEARC_IOS_SIGNING_MODE=registered
ENABLE_IOS_SHARE_EXTENSION=true
LITTLEARC_IOS_PERSONAL_BUNDLE_IDENTIFIER=com.nishanth.littlearc.dev
