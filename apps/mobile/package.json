{
  "name": "@littlearc/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "LittleArc Expo mobile application",
  "main": "index.ts",
  "scripts": {
    "android": "EXPO_ROUTER_APP_ROOT=app expo run:android",
    "build": "pnpm run build:android && pnpm run build:ios",
    "build:android": "EXPO_ROUTER_APP_ROOT=app expo export --platform android --output-dir dist/android",
    "build:ios": "EXPO_ROUTER_APP_ROOT=app expo export --platform ios --output-dir dist/ios",
    "clean": "rm -rf dist .expo android ios",
    "dev:android:usb": "EXPO_UNSTABLE_MCP_SERVER=1 EXPO_ROUTER_APP_ROOT=app expo start --dev-client --localhost",
    "dev": "EXPO_ROUTER_APP_ROOT=app expo start --dev-client",
    "dev:mcp": "EXPO_UNSTABLE_MCP_SERVER=1 EXPO_ROUTER_APP_ROOT=app expo start --dev-client",
    "doctor": "expo-doctor",
    "ios": "EXPO_ROUTER_APP_ROOT=app expo run:ios",
    "native:prebuild": "EXPO_ROUTER_APP_ROOT=app expo prebuild --clean",
    "start": "EXPO_ROUTER_APP_ROOT=app expo start --dev-client",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.23",
    "@infinitered/react-native-mlkit-text-recognition": "5.0.1",
    "@littlearc/contracts": "workspace:*",
    "@littlearc/design-tokens": "workspace:*",
    "@littlearc/domain": "workspace:*",
    "@littlearc/observability": "workspace:*",
    "@react-native/normalize-colors": "0.86.0",
    "@tanstack/react-query": "5.101.4",
    "better-auth": "1.6.23",
    "expo": "57.0.8",
    "expo-build-properties": "57.0.7",
    "expo-constants": "57.0.7",
    "expo-crypto": "57.0.1",
    "expo-dev-client": "57.0.8",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "57.0.1",
    "expo-image-picker": "57.0.6",
    "expo-linking": "57.0.4",
    "expo-local-authentication": "57.0.2",
    "expo-network": "57.0.1",
    "expo-notifications": "57.0.7",
    "expo-router": "57.0.8",
    "expo-secure-store": "57.0.1",
    "expo-sqlite": "57.0.1",
    "expo-system-ui": "57.0.1",
    "expo-web-browser": "57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-document-scanner-plugin": "2.0.4",
    "react-native-gesture-handler": "2.32.0",
    "react-native-nitro-modules": "0.36.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-unistyles": "3.3.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "babel-preset-expo": "57.0.3",
    "expo-doctor": "1.20.1",
    "expo-mcp": "0.2.4"
  }
}
