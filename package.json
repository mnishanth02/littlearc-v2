{
  "name": "littlearc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LittleArc mobile-first pediatric history platform",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.14.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm check:toolchain && pnpm check:workspace && pnpm check:format",
    "check:environment": "node tooling/environment/check-environment.mjs",
    "check:format": "biome ci . && markdownlint-cli2",
    "check:toolchain": "node tooling/check-toolchain.mjs",
    "check:workspace": "vitest run tooling && node tooling/boundaries/check-boundaries.mjs && pnpm check:environment",
    "clean": "turbo run clean",
    "format": "biome check --write .",
    "test": "turbo run test",
    "typecheck": "pnpm typecheck:tooling && turbo run typecheck",
    "typecheck:tooling": "tsc --project tooling/tsconfig.json",
    "validate": "pnpm check && pnpm typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "24.13.3",
    "markdownlint-cli2": "0.23.1",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
