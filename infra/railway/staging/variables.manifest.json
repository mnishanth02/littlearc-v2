{
  "dataPolicy": "synthetic-only",
  "environment": "staging",
  "productionProvisioning": "deferred",
  "region": "asia-southeast1-eqsg3a",
  "services": [
    {
      "configFile": "infra/railway/staging/api.railway.json",
      "kind": "web",
      "name": "littlearc-api-staging",
      "requiredVariables": [
        {
          "classification": "public",
          "name": "APP_ENV",
          "source": "literal:staging"
        },
        {
          "classification": "public",
          "name": "HOST",
          "source": "literal:0.0.0.0"
        },
        {
          "classification": "public",
          "name": "PORT",
          "source": "railway-injected"
        },
        {
          "classification": "secret",
          "name": "DATABASE_URL",
          "source": "railway-postgres-reference"
        },
        {
          "classification": "secret",
          "name": "BETTER_AUTH_SECRET",
          "source": "railway-secret"
        },
        {
          "classification": "public",
          "name": "AUTH_BASE_URL",
          "source": "railway-domain"
        },
        {
          "classification": "sensitive",
          "name": "AUTH_TRUSTED_ORIGINS",
          "source": "explicit-staging-origins"
        },
        {
          "classification": "public",
          "name": "AUTH_EMAIL_FROM",
          "source": "synthetic-staging-sender"
        },
        {
          "classification": "secret",
          "name": "RESEND_API_KEY",
          "source": "railway-secret"
        },
        {
          "classification": "sensitive",
          "name": "S3_ENDPOINT",
          "source": "railway-bucket-reference"
        },
        {
          "classification": "secret",
          "name": "S3_ACCESS_KEY_ID",
          "source": "railway-secret"
        },
        {
          "classification": "secret",
          "name": "S3_SECRET_ACCESS_KEY",
          "source": "railway-secret"
        },
        {
          "classification": "sensitive",
          "name": "S3_BUCKET_NAME",
          "source": "railway-bucket-reference"
        },
        {
          "classification": "public",
          "name": "S3_REGION",
          "source": "literal:auto"
        },
        {
          "classification": "public",
          "name": "UPLOADS_ENABLED",
          "source": "literal:true"
        },
        {
          "classification": "secret",
          "name": "KEY_WRAPPING_SECRET_V1",
          "source": "railway-secret"
        }
      ]
    },
    {
      "configFile": "infra/railway/staging/clamav.railway.json",
      "kind": "worker",
      "name": "littlearc-clamav-staging",
      "requiredVariables": []
    },
    {
      "configFile": "infra/railway/staging/worker.railway.json",
      "kind": "worker",
      "name": "littlearc-worker-staging",
      "requiredVariables": [
        {
          "classification": "public",
          "name": "APP_ENV",
          "source": "literal:staging"
        },
        {
          "classification": "secret",
          "name": "DATABASE_URL",
          "source": "railway-postgres-reference"
        },
        {
          "classification": "sensitive",
          "name": "S3_ENDPOINT",
          "source": "railway-bucket-reference"
        },
        {
          "classification": "secret",
          "name": "S3_ACCESS_KEY_ID",
          "source": "railway-secret"
        },
        {
          "classification": "secret",
          "name": "S3_SECRET_ACCESS_KEY",
          "source": "railway-secret"
        },
        {
          "classification": "sensitive",
          "name": "S3_BUCKET_NAME",
          "source": "railway-bucket-reference"
        },
        {
          "classification": "public",
          "name": "S3_REGION",
          "source": "literal:auto"
        },
        {
          "classification": "secret",
          "name": "KEY_WRAPPING_SECRET_V1",
          "source": "railway-secret"
        },
        {
          "classification": "public",
          "name": "FILE_VALIDATION_ENABLED",
          "source": "literal:true"
        },
        {
          "classification": "public",
          "name": "FILE_PREVIEWS_ENABLED",
          "source": "literal:false"
        },
        {
          "classification": "public",
          "name": "FILE_VALIDATION_STAGING_PROBE",
          "source": "literal:false"
        },
        {
          "classification": "sensitive",
          "name": "FILE_VALIDATION_TMP_DIR",
          "source": "literal:/tmp/littlearc-file-validation"
        },
        {
          "classification": "public",
          "name": "FILE_VALIDATION_CONCURRENCY",
          "source": "literal:1"
        },
        {
          "classification": "sensitive",
          "name": "FILE_VALIDATION_SANDBOX_EXECUTABLE",
          "source": "literal:/usr/bin/setpriv"
        },
        {
          "classification": "sensitive",
          "name": "QPDF_EXECUTABLE",
          "source": "literal:/app/apps/worker/.tools/qpdf-12.3.2/bin/qpdf"
        },
        {
          "classification": "sensitive",
          "name": "CLAMD_HOST",
          "source": "railway-private-domain-reference"
        },
        {
          "classification": "sensitive",
          "name": "CLAMD_PORT",
          "source": "literal:3310"
        },
        {
          "classification": "public",
          "name": "CLAMD_SIGNATURE_MAX_AGE_HOURS",
          "source": "literal:72"
        },
        {
          "classification": "public",
          "name": "CLAMD_SIGNATURE_MIN_VERSION",
          "source": "staging-freshclam-attestation"
        },
        {
          "classification": "public",
          "name": "CLAMD_SIGNATURE_OBSERVED_AT",
          "source": "staging-freshclam-attestation"
        },
        {
          "classification": "public",
          "name": "RAILPACK_BUILD_APT_PACKAGES",
          "source": "literal:unzip"
        },
        {
          "classification": "public",
          "name": "RAILPACK_DEPLOY_APT_PACKAGES",
          "source": "literal:libatomic1 util-linux"
        }
      ]
    },
    {
      "configFile": "infra/railway/staging/ops-web.railway.json",
      "kind": "web",
      "name": "littlearc-ops-web-staging",
      "requiredVariables": [
        {
          "classification": "public",
          "name": "APP_ENV",
          "source": "literal:staging"
        },
        {
          "classification": "public",
          "name": "NEXT_PUBLIC_APP_URL",
          "source": "railway-domain"
        },
        {
          "classification": "sensitive",
          "name": "STAFF_API_BASE_URL",
          "source": "railway-api-domain"
        },
        {
          "classification": "secret",
          "name": "BETTER_AUTH_SECRET",
          "source": "railway-secret"
        }
      ]
    },
    {
      "kind": "postgresql",
      "name": "Postgres",
      "requiredVariables": [
        {
          "classification": "secret",
          "name": "DATABASE_URL",
          "source": "railway-postgres-reference"
        }
      ]
    },
    {
      "kind": "bucket",
      "name": "littlearc-documents-staging",
      "requiredVariables": [
        {
          "classification": "sensitive",
          "name": "S3_BUCKET_NAME",
          "source": "railway-bucket-reference"
        }
      ]
    },
    {
      "kind": "bucket",
      "name": "littlearc-recovery-staging",
      "requiredVariables": []
    }
  ]
}
