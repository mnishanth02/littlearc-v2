{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @littlearc/worker... build",
    "watchPatterns": [
      "/apps/worker/**",
      "/packages/database/**",
      "/packages/storage/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/turbo.json"
    ]
  },
  "deploy": {
    "drainingSeconds": 15,
    "restartPolicyMaxRetries": 10,
    "restartPolicyType": "ALWAYS",
    "startCommand": "pnpm --filter @littlearc/worker start"
  }
}
