{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/railway/staging/worker/Dockerfile",
    "watchPatterns": [
      "/apps/worker/**",
      "/packages/crypto/**",
      "/packages/database/**",
      "/packages/domain/**",
      "/packages/observability/**",
      "/packages/storage/**",
      "/tooling/file-validation/**",
      "/infra/railway/staging/worker/**",
      "/infra/railway/staging/worker-image-dependencies.json",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/turbo.json"
    ]
  },
  "deploy": {
    "drainingSeconds": 15,
    "preDeployCommand": "node apps/worker/dist/staging-probe.js",
    "restartPolicyMaxRetries": 10,
    "restartPolicyType": "ALWAYS",
    "startCommand": "node apps/worker/dist/index.js"
  }
}
