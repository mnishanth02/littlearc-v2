{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @littlearc/ops-web... build",
    "watchPatterns": [
      "/apps/ops-web/**",
      "/packages/contracts/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/turbo.json"
    ]
  },
  "deploy": {
    "drainingSeconds": 15,
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 300,
    "overlapSeconds": 30,
    "restartPolicyMaxRetries": 10,
    "restartPolicyType": "ALWAYS",
    "startCommand": "pnpm --filter @littlearc/ops-web start"
  }
}
